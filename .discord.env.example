# Tip: `python scripts/mybot_admin.py connect discord` walks you through creating
# the app, validates the token, and writes this file for you.

# Discord bot token from the Discord Developer Portal.
DISCORD_BOT_TOKEN=REGENERATE_AND_PASTE_FRESH_TOKEN_HERE

# Auto-name the bot '<owner-handle>-mybot' per server so a team's instances are
# distinguishable (needs the 'Change Nickname' permission). BOT_HANDLE /
# BOT_NAME_TEMPLATE (in .env) override the derived name.
DISCORD_SET_GUILD_NICKNAME=true

# Cross-bot relay: Discord user ids of teammates' mybot bots you trust to relay
# human questions to you (comma-separated). Only their relay-tagged, mention-
# addressed messages are answered (as the asking human, guest scope); everything
# else from bots is still ignored. Empty (default) = feature off.
MYBOT_SIBLING_BOT_IDS=

# Faster slash-command sync for development. Set this to your server ID.
DISCORD_COMMAND_GUILD_ID=

# Optional: limit bot message-mode replies to these channel IDs.
DISCORD_ALLOWED_CHANNEL_IDS=
DISCORD_AUTO_REPLY_CHANNEL_IDS=

# Message-mode behavior. Dedicated auto-reply channels can work without mentions.
DISCORD_ENABLE_MESSAGE_CONTENT=true
DISCORD_REQUIRE_MENTION_IN_GUILDS=true
DISCORD_MESSAGE_COALESCE_SECONDS=1.25

# Chatbot transport settings.
DISCORD_USE_TRAJECTORY_MEMORY=true
DISCORD_MAX_OUTPUT_TOKENS=1200
CHATBOT_HOST=127.0.0.1
CHATBOT_PORT=8787
CHATBOT_BASE_URL=http://127.0.0.1:8787

# Launcher supervision. The run script keeps the Discord bridge alive after
# transient failures and refuses to start a second local mybot bridge.
START_LOCAL_CHAT_SERVER=true
SUPERVISE_DISCORD_BRIDGE=true
MYBOT_SINGLE_INSTANCE=true
MYBOT_RESTART_DELAY_SECONDS=5
MYBOT_MAX_RESTART_DELAY_SECONDS=60
MYBOT_SERVER_START_TIMEOUT_SECONDS=30
MYBOT_SERVER_HEALTH_INTERVAL_SECONDS=15
