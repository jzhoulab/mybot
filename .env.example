MODEL_BACKEND=codex_cli
CODEX_COMMAND=/Applications/Codex.app/Contents/Resources/codex
CODEX_PERMISSION_PROFILE=mybot_restricted
CODEX_NETWORK_ACCESS=true
CODEX_IGNORE_USER_CONFIG=true
CODEX_DISABLE_BACKEND_RESUME=true
CODEX_EPHEMERAL=true
CODEX_SERVICE_TIER=fast
# Optional Codex settings:
# MODEL_NAME=gpt-5.4
# CODEX_CWD=/absolute/path/to/Code/mybot-runtime/default
# MYBOT_TOOL_PYTHON=/usr/bin/python3

# For an OpenAI-compatible backend, switch MODEL_BACKEND and set:
# MODEL_BACKEND=openai_compatible
# MODEL_BASE_URL=https://api.openai.com/v1
# MODEL_API_KEY=replace-me
# MODEL_NAME=gpt-4.1-mini

TRAJECTORY_SOURCES=codex,claude
TRAJECTORY_ACCESS_CONFIG_PATH=/absolute/path/to/your/repo/config/access.json
# Who the owner is. Use your Discord/Slack user id if you run a bridge, or any
# stable string for solo local use. Must match the actor_id your client sends,
# or private-scope search comes back empty.
MEMORY_IMPORTED_OWNER_ID=local-owner
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
TRAJECTORY_MAX_FILES_PER_TOOL=1000
TRAJECTORY_INVESTIGATION_MODE=auto
TRAJECTORY_SEARCH_LIMIT=5
TRAJECTORY_EVIDENCE_LIMIT=2
TRAJECTORY_EVIDENCE_CHARS=18000
TRAJECTORY_INDEX_DB_PATH=/absolute/path/to/your/repo/state/trajectory_index.sqlite3
TRAJECTORY_INDEX_CHUNK_CHARS=4800
TRAJECTORY_INDEX_OVERLAP_CHARS=800
TRAJECTORY_INDEX_AUTOBUILD=true
# Embedding every chunk during an incremental refresh is slow. Left false,
# refresh keeps keyword search current and you backfill vectors separately with
# `mybot_admin.py maintenance --action embed`.
TRAJECTORY_INDEX_AUTOBUILD_VECTORS=false
TRAJECTORY_INDEX_AUTOBUILD_MIN_INTERVAL_SECONDS=300
TRAJECTORY_INDEX_BACKGROUND_REFRESH_SECONDS=300
TRAJECTORY_INDEX_REFRESH_MAX_SESSIONS=0
# Optional lossless Codex trajectory storage. The archive defaults to
# state/trajectory_archive and is namespaced per canonical Codex home.
# TRAJECTORY_ARCHIVE_ROOT=/absolute/path/to/private/trajectory_archive
# CODEX_TRAJECTORY_TRIMMER_COMMAND=/absolute/path/to/codex-jsonl-trim
# Keep writes disabled unless you are intentionally running the local-only
# `mybot_admin.py trajectory-storage ... --apply` maintenance surface.
MYBOT_TRAJECTORY_MAINTENANCE_ENABLED=false
TRAJECTORY_AGENTIC_SEARCH=true
TRAJECTORY_AGENTIC_MAX_STEPS=6
# LLM query planner: when retrieval is weak or the query is a vague, context-
# dependent follow-up, the model proposes precise search queries and iterates.
TRAJECTORY_QUERY_PLANNER=true
# Optional jargon expansions for retrieval: `keyword=extra terms` pairs, `;`
# separated. A query mentioning the keyword is also searched with the extra
# terms, which is how you teach mybot your own infrastructure's vocabulary.
# TRAJECTORY_QUERY_HINTS=proddb=replica lag failover;billing=invoice dunning
TRAJECTORY_QUERY_PLANNER_MAX_ROUNDS=2
TRAJECTORY_QUERY_PLANNER_MAX_QUERIES=4
AGENTIC_TOOL_ROUTING=true
# MYBOT_TOOL_PATH=/absolute/path/to/Code/mybot-runtime/default/bin/mybot_tool.py
HISTORY_MAX_MESSAGES=24
SESSION_TAIL_PAIRS=12
COMPACTION_TRIGGER_MESSAGES=40
COMPACTION_TRIGGER_CHARS=16000
MEMORY_MATCH_LIMIT=5
# Prefer an absolute path if you launch the server outside the repo root.
SYNC_TOKENS_PATH=/absolute/path/to/your/repo/config/sync_tokens.json

# Hard wall-clock cap for one agentic trajectory search (planner rounds are
# skipped once spent). Prevents weak queries from cascading into minutes of
# model-driven retries.
TRAJECTORY_SEARCH_TIME_BUDGET_SECONDS=25

# Default retrieval seconds across ALL tool searches within one chat request.
# A pacing default, not a wall: when spent, the agent must either answer with
# what it has or deliberately extend (`mybot budget --extend N --reason ...`);
# every extension and its reason is shown in the reply. Askers can override
# per request via `budget_seconds` in the /chat body.
MYBOT_TOOL_TOTAL_BUDGET_SECONDS=90

# Hard ceiling the budget can never exceed, extensions and overrides included.
MYBOT_TOOL_MAX_BUDGET_SECONDS=600

# mybot launches codex with --ignore-user-config, so ~/.codex/config.toml is NOT
# applied. Set the agent model + reasoning depth explicitly here. xhigh = deepest
# thinking for user-facing answers; the internal query planner uses a cheap tier
# so retrieval stays fast.
CODEX_MODEL=gpt-5.5
CODEX_REASONING_EFFORT=xhigh
CODEX_PLANNER_REASONING_EFFORT=low

# Agent backend: 'claude_cli' (Claude Opus 4.8), 'codex_cli' (gpt-5.5), or
# 'openai_compatible'. The menu app switches this live via state/model_config.json
# (read per-request, no restart). CLAUDE_* apply to the claude_cli backend.
CLAUDE_COMMAND=claude   # or an absolute path, e.g. $HOME/.local/bin/claude
CLAUDE_MODEL=opus   # alias -> latest Opus (or sonnet/fable, or a full name)
CLAUDE_THINKING=xhigh   # low|medium|high|xhigh|max (from `claude --effort`)
CLAUDE_PLANNER_THINKING=low
