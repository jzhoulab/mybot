# Slack bridge config. Copy to .slack.env and fill in.
# Socket Mode (no public URL needed).
#
# Slack app setup (api.slack.com/apps -> Create New App -> From scratch):
#   1. Socket Mode: enable it, generate an App-Level Token with connections:write
#      -> that's SLACK_APP_TOKEN (xapp-...).
#   2. OAuth & Permissions -> Bot Token Scopes:
#        app_mentions:read, chat:write, channels:history, groups:history,
#        im:history, mpim:history, channels:read, groups:read, users:read,
#        reactions:write
#      Install to workspace -> Bot User OAuth Token -> SLACK_BOT_TOKEN (xoxb-...).
#   3. Event Subscriptions -> Subscribe to bot events:
#        message.channels, message.groups, message.im, message.mpim, app_mention
#   4. Invite the bot to the channels it should watch: /invite @yourbot

SLACK_BOT_TOKEN=xoxb-REPLACE-ME
SLACK_APP_TOKEN=xapp-REPLACE-ME

# Optional (defaults shown):
# SLACK_GROUP_SESSIONS=true      # one shared session per channel (threads get their own)
# SLACK_OBSERVE_CHANNELS=true    # record non-addressed channel messages for context
# SLACK_USE_TRAJECTORY_MEMORY=true
# CHATBOT_BASE_URL=http://127.0.0.1:8788
