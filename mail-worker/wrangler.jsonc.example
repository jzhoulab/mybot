// One Worker serves every teammate's mybot mailbox. To set it up once:
//   cp wrangler.jsonc.example wrangler.jsonc   (gitignored)
//   npx wrangler kv namespace create MAIL_QUEUE   → paste the id below
//   npx wrangler deploy
// Then add mailboxes with scripts/mail_mailbox.py (no redeploy needed).
{
  "name": "mybot-mail",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "kv_namespaces": [{ "binding": "MAIL_QUEUE", "id": "<kv namespace id>" }],
  // Sends only to verified destination addresses in the account; the Worker
  // further limits each mailbox to its own owner.
  "send_email": [{ "name": "EMAIL" }]
}
