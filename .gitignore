# --- Secrets and local config -------------------------------------------------
.env
.env.local
.discord.env
.discord2.env
.slack.env
config/sync_tokens.json
config/access.json
# Retrieval test cases name your own projects and pin real session ids.
scripts/demo_queries.local.json

# --- Runtime state ------------------------------------------------------------
# Everything under state/ is local to one machine: transcripts, the SQLite
# databases, the person registry, index markers, live model selection. Only the
# directory markers are tracked, so a new runtime artifact can never leak.
state/*
!state/.gitkeep
!state/sessions
state/sessions/*
!state/sessions/.gitkeep
!state/archived_sessions
state/archived_sessions/*
!state/archived_sessions/.gitkeep

profiles/*/.mybot/
backups/

# --- Logs ---------------------------------------------------------------------
logs/
*.log
screenlog.*

# --- Build artifacts ----------------------------------------------------------
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
macapp/.build/
macapp/.dist/

# --- Databases (anywhere) -----------------------------------------------------
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# --- OS -----------------------------------------------------------------------
.DS_Store
